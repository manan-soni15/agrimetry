# =============================================================================
# AGRIMETRY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env.local to configure your local developer environment:
#   cp .env.example .env.local
#
# All credentials listed here are strictly server-side and never exposed to
# client-side JavaScript or public browser bundles.
# Leave blank to run Agrimetry in open-discovery mode (CMR + STAC + NASA POWER).
# =============================================================================

# -----------------------------------------------------------------------------
# FEATURE 1: COPERNICUS DATA SPACE ECOSYSTEM (CDSE) / SENTINEL HUB
# -----------------------------------------------------------------------------
# Used server-side by lib/vegetation/copernicus-auth.js to request OAuth2 access
# tokens for the Sentinel Hub Statistical API (https://sh.dataspace.copernicus.eu).
# Enables pixel-level Sentinel-2 L2A surface reflectance and NDVI time-series statistics.
# Register for free at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# -----------------------------------------------------------------------------
# FEATURE 2: NASA EARTHDATA LOGIN (URS)
# -----------------------------------------------------------------------------
# Used server-side by lib/water/smap-client.js and lib/water/imerg-client.js.
# Enables authenticated downloading and decoding of binary HDF5 satellite datasets:
# - NASA SMAP L4 Global 9 km Soil Moisture (SPL4SMGP V008, NSIDC DAAC)
# - NASA GPM IMERG Early Precipitation L3 Half-Hourly 0.1° (GPM_3IMERGHHE.07, GES DISC)
# Register for free at: https://urs.earthdata.nasa.gov/
# Generate a personal bearer token in your Earthdata profile under "Generate Token".
EARTHDATA_TOKEN=your-earthdata-bearer-token

# Optional alternative authentication using Earthdata username and password
EARTHDATA_USERNAME=your-earthdata-username
EARTHDATA_PASSWORD=your-earthdata-password

